# Hybrid Phishing URL Trap - Environment Configuration
# Copy this file to .env for local customized configuration

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
# Options: 'local' (default) or 'vercel'
# In 'local' mode: uses instance/honeypot_logs.db with persistent SQLite.
# In 'vercel' mode: uses ephemeral /tmp/honeypot_logs.db suitable for serverless functions.
DEPLOYMENT_MODE=local

# Optional custom database path (defaults to /tmp/honeypot_logs.db when DEPLOYMENT_MODE=vercel)
# VERCEL_DB_PATH=/tmp/honeypot_logs.db

# Optional custom model path if storing .joblib in a non-standard location
# MODEL_PATH=models/model.joblib

# -----------------------------------------------------------------------------
# Flask Security & Network Configuration
# -----------------------------------------------------------------------------
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
PORT=5000
FLASK_DEBUG=False

# -----------------------------------------------------------------------------
# External Threat Feed Configuration (Optional)
# -----------------------------------------------------------------------------
# PHISHTANK_FEED_URL=https://data.phishtank.com/data/online-valid.json
# PHISHTANK_API_KEY=your_phishtank_api_key_here
